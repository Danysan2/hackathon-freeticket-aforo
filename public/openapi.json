{
  "openapi": "3.1.0",
  "info": {
    "title": "Hackathon FreeTicket — API de datos",
    "version": "1.0.0",
    "description": "Dos plataformas que hablan de la misma gente y nunca se han mirado entre sí. Una petición toca una sola: cruzarlas es el reto.\n\nEl contrato en prosa, pensado para agentes, está en `GET /`."
  },
  "servers": [
    {
      "url": "https://hackathon-freeticket.vercel.app"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "El token que entrega `/api/setup`."
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "El contrato completo, en texto plano",
        "description": "Todo lo que un agente necesita para operar: el reto, el calendario, la regla, cómo sacar el token y cada recurso con sus filtros. Sin autenticación.",
        "security": [],
        "responses": {
          "200": {
            "description": "El contrato",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/setup": {
      "get": {
        "summary": "Consigue tu token",
        "description": "Instantáneo, sin registro. Idempotente: el mismo handle devuelve siempre el mismo token.",
        "security": [],
        "parameters": [
          {
            "name": "handle",
            "in": "query",
            "required": true,
            "description": "Tu nombre, 2 a 40 caracteres.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "nuevo": {
                      "type": "boolean"
                    },
                    "handle": {
                      "type": "string"
                    },
                    "token": {
                      "type": "string"
                    },
                    "api": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Handle inválido"
          }
        }
      }
    },
    "/api/boom": {
      "get": {
        "summary": "Boom — membresías (v2)",
        "description": "Sin `resource` devuelve el índice de la plataforma. Esta ruta NUNCA devuelve datos de la otra: cruzarlas es el reto.\n\nRecursos:\n- `users` — la base de membresías, fila por persona\n- `profile` — el usuario CON su historial resumido: tickets_total, tickets_used, use_rate, friends_count\n- `tickets` — historial fila por entrada; used dice si la persona entró\n- `social` — amigos por usuario",
        "parameters": [
          {
            "name": "resource",
            "in": "query",
            "required": false,
            "description": "Qué recurso consultar.",
            "schema": {
              "type": "string",
              "enum": [
                "users",
                "profile",
                "tickets",
                "social"
              ]
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "Filtro. Aplica a: users, profile, tickets.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "description": "Filtro. Aplica a: users, profile.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "phone",
            "in": "query",
            "description": "Filtro. Aplica a: users, profile.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "description": "Filtro. Aplica a: users, profile.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "membership",
            "in": "query",
            "description": "Filtro. Aplica a: users, profile.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "last_name",
            "in": "query",
            "description": "Filtro. Aplica a: users.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "first_name",
            "in": "query",
            "description": "Filtro. Aplica a: users.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_tickets",
            "in": "query",
            "description": "Filtro. Aplica a: profile.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_use_rate",
            "in": "query",
            "description": "Filtro. Aplica a: profile.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "user",
            "in": "query",
            "description": "Filtro. Aplica a: tickets, social.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "event",
            "in": "query",
            "description": "Filtro. Aplica a: tickets.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "used",
            "in": "query",
            "description": "Filtro. Aplica a: tickets.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Filtro. Aplica a: tickets.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Filtro. Aplica a: tickets.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Filas por página (tope 1000).",
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 1000
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Para paginar.",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Orden, p. ej. starts_at.asc",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "select",
            "in": "query",
            "description": "Columnas separadas por coma.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "json (por defecto) o csv.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filas del recurso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "plataforma": {
                      "type": "string"
                    },
                    "resource": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "description": "Total que existe, no el de la página."
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token o no es válido"
          },
          "404": {
            "description": "Recurso inexistente"
          }
        }
      }
    },
    "/api/freeticket": {
      "get": {
        "summary": "FreeTicket — tiquetera (free-admin)",
        "description": "Sin `resource` devuelve el índice de la plataforma. Esta ruta NUNCA devuelve datos de la otra: cruzarlas es el reto.\n\nRecursos:\n- `artists` — actos, su residencia y cómo les fue en julio\n- `events` — shows con tickets_sold, checked_in_count (null en agosto), attendance_rate y fill_rate\n- `sales` — ventas: comprador, canal, cuándo compró, cuántas entradas\n- `tickets` — una fila por entrada; checked_in es true/false en julio y null en agosto",
        "parameters": [
          {
            "name": "resource",
            "in": "query",
            "required": false,
            "description": "Qué recurso consultar.",
            "schema": {
              "type": "string",
              "enum": [
                "artists",
                "events",
                "sales",
                "tickets"
              ]
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "Filtro. Aplica a: artists, events, sales, tickets.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Filtro. Aplica a: artists, sales.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "description": "Filtro. Aplica a: artists, events.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "residency",
            "in": "query",
            "description": "Filtro. Aplica a: artists, events.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "artist",
            "in": "query",
            "description": "Filtro. Aplica a: events.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "venue",
            "in": "query",
            "description": "Filtro. Aplica a: events.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "month",
            "in": "query",
            "description": "Filtro. Aplica a: events.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "weekday",
            "in": "query",
            "description": "Filtro. Aplica a: events.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "upcoming",
            "in": "query",
            "description": "Filtro. Aplica a: events.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "event",
            "in": "query",
            "description": "Filtro. Aplica a: sales, tickets.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "description": "Filtro. Aplica a: sales.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "phone",
            "in": "query",
            "description": "Filtro. Aplica a: sales.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "channel",
            "in": "query",
            "description": "Filtro. Aplica a: sales.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sale",
            "in": "query",
            "description": "Filtro. Aplica a: tickets.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Filtro. Aplica a: tickets.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "checked_in",
            "in": "query",
            "description": "Filtro. Aplica a: tickets.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Filas por página (tope 1000).",
            "schema": {
              "type": "integer",
              "default": 100,
              "maximum": 1000
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Para paginar.",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Orden, p. ej. starts_at.asc",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "select",
            "in": "query",
            "description": "Columnas separadas por coma.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "json (por defecto) o csv.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filas del recurso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "plataforma": {
                      "type": "string"
                    },
                    "resource": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "description": "Total que existe, no el de la página."
                    },
                    "limit": {
                      "type": "integer"
                    },
                    "offset": {
                      "type": "integer"
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token o no es válido"
          },
          "404": {
            "description": "Recurso inexistente"
          }
        }
      }
    }
  }
}
